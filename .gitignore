# Unreal Engine generated directories
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# Generated directories inside plugins
/Plugins/**/Binaries/
/Plugins/**/DerivedDataCache/
/Plugins/**/Intermediate/
/Plugins/**/Saved/

# Local build output. Keep project icons and Pak blacklist files when present.
/Build/*
!/Build/*/
/Build/*/**
!/Build/*/PakBlacklist*.txt
!/Build/**/*.ico

# Unreal-generated project and IDE files
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.code-workspace
compile_commands.json
.vsconfig

# IDE and editor state
/.vs/
/.vscode/
/.idea/
/.fleet/
/.clangd/
/.ignore
*.user
*.userosscache
*.sln.docstates

# Compiler and linker output
*.a
*.app
*.dll
*.dylib
*.exe
*.exp
*.gch
*.ipa
*.la
*.lai
*.lib
*.lo
*.mod
*.o
*.obj
*.out
*.pch
*.pdb
*.slo
*.so

# Logs, crash dumps, and temporary files
*.bak
*.log
*.stackdump
*.tmp
*.userprefs
*~

# Operating-system metadata
.DS_Store
Desktop.ini
Thumbs.db
$RECYCLE.BIN/

# Precompiled source-art assets
/SourceArt/**/*.png
/SourceArt/**/*.tga

# Generated map build data
*_BuiltData.uasset
